# apps/worker configuration. Copy to .env for `pnpm dev`; never commit real values.
# Production values live in Fly secrets (`fly secrets set`), not here.

# Required. Postgres connection string for the worker's server-side role (it bypasses RLS, like
# the service-role key). Local stack from `pnpm db:start`:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the project's Supavisor *session* pooler string (Dashboard → Connect), port 5432.
DATABASE_URL=

# Optional; defaults shown.
# HOST=0.0.0.0
# PORT=8080
# LOG_LEVEL=info
# SHUTDOWN_TIMEOUT_MS=10000
