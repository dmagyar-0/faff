# apps/web configuration. Copy to .env.local for `pnpm dev`; never commit real values.
# Deployed values live in Vercel project settings. Previews and production share the one hosted
# Supabase project for now (M0-Q2).
#
# Nothing reads these yet; Supabase Auth arrives in M2. Local values come from `pnpm db:start`.

# Browser-safe: the project URL and the publishable (not secret) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
