{
  "name": "faff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deps": "depcruise packages apps evals",
    "rails": "node tooling/rails-selftest.mjs",
    "db:start": "supabase start --workdir packages/db",
    "db:stop": "supabase stop --workdir packages/db",
    "db:reset": "supabase db reset --workdir packages/db",
    "db:test": "supabase test db --workdir packages/db",
    "db:types": "supabase gen types typescript --local --workdir packages/db > packages/db/src/types.gen.ts && prettier --write --log-level warn packages/db/src/types.gen.ts",
    "db:rails": "node tooling/db-rails-selftest.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm deps && pnpm test && pnpm rails"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
